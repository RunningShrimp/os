// ============================================================================
// VM Exit Handler (Lines 251-350)
// ============================================================================

/// VM exit handler trait
pub trait VmExitHandler: Send + Sync {
    fn handle_exit(&self, vm_id: u64, vcpu_id: u32, exit: VmExitReason) -> Result<(), VirtualizationError>;
    fn handle_io(&self, vm_id: u64, vcpu_id: u32, port: u16, write: bool, data: &[u8]) -> Result<(), VirtualizationError>;
    fn handle_cpuid(&self, vm_id: u64, vcpu_id: u32, leaf: u32, subleaf: u32) -> Result<(u32, u32, u32, u32), VirtualizationError>;
}}

struct DefaultHandler;
impl VmExitHandler for DefaultHandler {
    fn handle_exit(&self, _id: u64, _vcpu: u32, _exit: VmExitReason) -> Result<(), VirtualizationError> { Ok(()) }}
    fn handle_io(&self, _id: u64, _vcpu: u32, _port: u16, _write: bool, _data: &[u8]) -> Result<(), VirtualizationError> { Ok(()) }}
    fn handle_cpuid(&self, _id: u64, _vcpu: u32, _leaf: u32, _subleaf: u32) -> Result<(u32, u32, u32, u32), VirtualizationError> { Ok((0, 0, 0, 0)) }}
}}

