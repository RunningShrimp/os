//! # Hypervisor Module - CPU Virtualization with VMX/SVM
//!
//! Hardware-assisted virtualization for Intel VT-x (VMX) and AMD-V (SVM).

#![allow(dead_code)]

use alloc::{boxed::Box, collections::BTreeMap, string::{String, ToString}}, sync::Arc, vec::Vec}};
use core::sync::atomic::{AtomicU64, Ordering}};
use crate::sync::{Mutex, RwLock}};
use crate::error::unified::{VirtualizationError}};

// ============================================================================
// Configuration and State (Lines 1-100)
// ============================================================================

/// VM configuration
#[derive(Debug, Clone)]
pub struct VmConfig {
    pub name: String,
    pub vcpu_count: u32,
    pub memory_size: u64,
    pub cpu_mask: Option<u64>,
    pub enable_ept: bool,
    pub enable_vpid: bool,
    pub enable_virtual_apic: bool,
}}

impl Default for VmConfig {
    fn default() -> Self {
        Self {
            name: String::from("vm"),
            vcpu_count: 1,
            memory_size: 512 * 1024 * 1024,
            cpu_mask: None,
            enable_ept: true,
            enable_vpid: true,
            enable_virtual_apic: true,
        }}
    }}
}}

/// vCPU configuration
#[derive(Debug, Clone)]
pub struct VcpuConfig {
    pub vcpu_id: u32,
    pub cpu_pin: Option<u32>,
    pub apic_id: u32,
}}

impl Default for VcpuConfig {
    fn default() -> Self {
        Self { vcpu_id: 0, cpu_pin: None, apic_id: 0 }}
    }}
}}

