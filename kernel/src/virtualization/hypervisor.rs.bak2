// ============================================================================
// VM Exit Reasons (Lines 101-250)
// ============================================================================

/// VM execution state
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum VmState {
    Created, Running, Paused, Stopped, Destroyed, Error,
}}

/// VM exit reason
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum VmExitReason {
    ExceptionNmi, ExternalInterrupt, TripleFault, InitSignal, Sipi,
    Io, MsrRead, MsrWrite, EntryGuest, ExitGuest,
    Cpuid, Getsec, Hlt, Invd, Invlpg, Rdpmc, Rdtsc,
    Rsm, Vmcall, Vmclear, Vmlaunch, Vmptrld, Vmptrst,
    Vmread, Vmresume, Vmwrite, Vmxoff, Vmxon,
    CrAccess, DrAccess, IoInstruction, Rdmsr, Wrmsr,
    EntryFailure, EptViolation, EptMisconfig, Invept,
    Rdtscp, VmexitPreemptionTimer, Invvpid, Wbinvd,
    Xsetbv, ApicWrite, Rdrand, Invepcid, Vmfunc,
    Encls, RdmsrList, WrmsrList, PmlFull, Xsaves,
    Xrstors, Unknown(u32),
}}

/// VMX exit reasons (Intel)
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
#[repr(u32)]
pub enum VmxExitReason {
    ExceptionNmi = 0, ExternalInterrupt = 1, TripleFault = 2,
    InitSignal = 3, Sipi = 4, Io = 30, MsrRead = 31,
    MsrWrite = 32, Cpuid = 10, Hlt = 12, Invd = 13,
    CrAccess = 28, DrAccess = 29, EptViolation = 48,
    EptMisconfig = 49, Invept = 50, Rdtscp = 51,
    Invvpid = 53, Wbinvd = 54, Xsetbv = 55,
}}

/// SVM exit reasons (AMD)
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
#[repr(u32)]
pub enum SvmExitReason {
    Vmrun = 0x01, Vmmcall = 0x02, Cpuid = 0x0F,
    Intr = 0x60, Nmi = 0x61, Hlt = 0x78, Io = 0x8B,
    Rdmsr = 0x8C, Wrmsr = 0x8D, Exception = 0x9D, NPf = 0x400,
}}

