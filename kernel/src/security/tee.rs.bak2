    /// Verify attestation
    pub fn verify_attestation(&self, attestation: &Attestation) -> TeeResult<bool> {
        // Validate attestation structure
        attestation.validate()?;

        // Get enclave
        let enclave = self.get_enclave(attestation.enclave_id)?;

        // Verify measurement matches
        if attestation.measurement.mrenclave != enclave.measurement.mrenclave {
            return Err(TeeError::MeasurementFailed);
        }

        // Verify signature
        match enclave.config.tee_type {
            TeeType::Sgx => self.verify_sgx_signature(attestation)?,
            TeeType::Sev | TeeType::SevEs | TeeType::SevSnp => {
                self.verify_sev_signature(attestation)?
            }
        }

        Ok(true)
    }

    /// Verify SGX signature
    fn verify_sgx_signature(&self, attestation: &Attestation) -> TeeResult<()> {
