    /// Get enclave statistics
    pub fn get_stats(&self) -> TeeResult<TeeStats> {
        let enclaves = self.enclaves.lock();
        let total_enclaves = enclaves.len();
        let mut active_enclaves = 0;
        let mut total_threads = 0;

        for enclave in enclaves.values() {
            if enclave.state == EnclaveState::Running {
                active_enclaves += 1;
            }
            total_threads += enclave.thread_count.load(Ordering::SeqCst);
        }

        Ok(TeeStats {
            total_enclaves,
            active_enclaves,
            total_threads,
            tee_available: self.is_tee_available(),
            tee_type: self.tee_type(),
        })
    }
}

/// TEE statistics
#[derive(Debug, Clone)]
pub struct TeeStats {
    /// Total number of enclaves
    pub total_enclaves: usize,
    /// Number of active enclaves
    pub active_enclaves: usize,
    /// Total number of threads in enclaves
    pub total_threads: u64,
    /// TEE available
    pub tee_available: bool,
    /// TEE type
    pub tee_type: Option<TeeType>,
}

// ============================================================================
// Global TEE Manager
// ============================================================================

static TEE_MANAGER: spin::Mutex<TeeManager> = spin::Mutex::new(TeeManager::new());

/// Get global TEE manager
pub fn tee_manager() -> ''static TeeManager {
    &TEE_MANAGER
}
    &TEE_MANAGER
}

/// Initialize TEE subsystem
pub fn init_tee(tee_type: TeeType) -> TeeResult<()> {
    TEE_MANAGER.init(tee_type)
}

/// Create enclave
pub fn create_enclave(config: &EnclaveConfig) -> TeeResult<EnclaveId> {
    TEE_MANAGER.create_enclave(config.clone())
}

/// Enter enclave
pub fn enter_enclave(id: EnclaveId, entry: u64) -> TeeResult<u64> {
    TEE_MANAGER.enter_enclave(id, entry)
}

/// Exit enclave
pub fn exit_enclave(id: EnclaveId, result: u64) -> TeeResult<()> {
    TEE_MANAGER.exit_enclave(id, result)
}

/// Destroy enclave
pub fn destroy_enclave(id: EnclaveId) -> TeeResult<()> {
    TEE_MANAGER.destroy_enclave(id)
}

/// Attest enclave
pub fn attest_enclave(id: EnclaveId) -> TeeResult<Attestation> {
    TEE_MANAGER.attest_enclave(id)
}

/// Verify attestation
pub fn verify_attestation(attestation: &Attestation) -> TeeResult<bool> {
    TEE_MANAGER.verify_attestation(attestation)
}

/// Provision key to enclave
pub fn provision_key(id: EnclaveId, key_data: &[u8]) -> TeeResult<()> {
    TEE_MANAGER.provision_key(id, key_data)
}

/// Get TEE statistics
pub fn get_tee_stats() -> TeeResult<TeeStats> {
    TEE_MANAGER.get_stats()
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_enclave_config_validation() {
        let config = EnclaveConfig::new(
            TeeType::Sgx,
            0x1000_0000,
            0x10_0000,
            0x1000_1000,
        );
        assert!(config.validate().is_ok());
    }

    #[test]
    fn test_enclave_id() {
        let id = EnclaveId::new(42);
        assert!(id.is_valid());
        assert_eq!(id.0, 42);
    }

    #[test]
    fn test_attestation_validation() {
        let mut attestation = Attestation::new(EnclaveId::new(1));
        attestation.measurement.mrenclave[0] = 0x01;
        assert!(attestation.validate().is_ok());
    }
}
