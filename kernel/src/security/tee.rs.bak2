        Ok(())
    }

    /// Provision key to enclave
    pub fn provision_key(&self, id: EnclaveId, key_data: &[u8]) -> TeeResult<()> {
        // Get enclave
        let enclave = self.get_enclave(id)?;

        // Verify attestation first
        let attestation = self.attest_enclave(id)?;
        self.verify_attestation(&attestation)?;

        // Establish secure channel
        self.establish_secure_channel(id)?;

        // Provision key
        self.provision_key_internal(id, key_data)
    }

    /// Establish secure channel
